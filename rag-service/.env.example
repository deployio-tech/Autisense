# RAG Service
# Groq
GROQ_API_KEY=your_groq_api_key_here
# Model (see https://console.groq.com/docs/deprecations)
# llama3-70b-8192 was deprecated; use a supported replacement
GROQ_MODEL=llama-3.3-70b-versatile
# Tuning (optional)
# Higher max tokens gives more detailed plans
GROQ_MAX_TOKENS=700
GROQ_TEMPERATURE=0.2

# Chroma persistence
RAG_CHROMA_PATH=./chroma_db
RAG_COLLECTION_NAME=medical_reports

# CORS
RAG_ALLOWED_ORIGINS=https://autisense.deployio.tech,https://autisense-rag.deployio.tech,http://localhost:5173,http://localhost:3000,http://localhost:5001
